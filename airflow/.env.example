# Copy to airflow/.env and fill in. airflow/.env is git-ignored.
# Values for GCP_* / WEATHER_* come from `terraform output` in ../terraform.

# Container user = your host UID (macOS/Linux: `id -u`), so mounted files are readable.
AIRFLOW_UID=50000

# Generate: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
AIRFLOW__API_AUTH__JWT_SECRET=

# Host port for the Airflow UI (http://localhost:<port>)
AIRFLOW_WEB_PORT=8081

# Web UI login
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# GCP access: your ADC is used only to impersonate this service account
GCP_PROJECT_ID=your-project-id
GCP_IMPERSONATE_SA=weather-dev-airflow@your-project-id.iam.gserviceaccount.com
# Optional: path to your ADC file (default ~/.config/gcloud/application_default_credentials.json)
# GCP_ADC_FILE=

# Pipeline
WEATHER_DATA_BUCKET=your-project-id-weather-dev-data
WEATHER_BRONZE_PREFIX=bronze/weather/realtime
WEATHER_SILVER_PREFIX=silver/weather/realtime
WEATHER_GOLD_TABLE=your-project-id.weather_gold.weather_realtime
